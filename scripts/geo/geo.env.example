# Скопируйте в scripts/geo/geo.env и заполните. Файл в .gitignore — не коммитить!
# Хосты площадок
NSK_HOST=p279i03mon01
MSK_HOST=p279i43mon01

SSH_USER=root
# Каталог стека Auto SRE на узлах
STACK_DIR=/opt/docker/auto-sre

# Сервисы-писатели основного стека (останавливаются на время переключения PG)
APP_SERVICES="sre-agent alert-analyzer"

# Пароль роли replicator (тот же, что в ansible-vault auto_sre_pg_replication_password)
AUTO_SRE_PG_REPLICATION_PASSWORD=

# Порог лага репликации для планового свитчовера, сек
MAX_LAG_SECONDS=5
# Таймаут ожидания синхронизации WAL-позиций при свитчовере, сек
LSN_SYNC_TIMEOUT=120
