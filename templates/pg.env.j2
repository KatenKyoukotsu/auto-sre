# .env для docker-compose.pg.yml — рендерится Ansible на каждый узел кластера
POSTGRES_DB={{ auto_sre_postgres_db | default('auto_sre') }}
POSTGRES_USER={{ auto_sre_postgres_user | default('auto_sre') }}
POSTGRES_PASSWORD={{ auto_sre_postgres_password }}

# Служебные роли кластера (создаются init-cluster.sh только на мастере)
PG_REPLICATION_PASSWORD={{ auto_sre_pg_replication_password }}
PG_POOL_PASSWORD={{ auto_sre_pg_pool_password }}

# Куда смотрит pgbouncer-rw (порт 15432 узла). Изначально — текущий первичный узел.
# Обновляется скриптами geo-pg-switchover.sh / geo-pg-failover.sh при смене ролей.
PG_RW_TARGET_HOST={{ auto_sre_pg_primary_host }}
